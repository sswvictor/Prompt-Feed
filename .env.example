# copy to .env locally; do not commit .env

OPENAI_API_KEY=

# without a key, dialogue uses MockChatProvider
DIALOGUE_ENABLE_GPT=true
DIALOGUE_MODEL=gpt-4o-mini
DIALOGUE_INJECT_INTENTION_BLOCK=true
DIALOGUE_MAX_HISTORY_TURNS=6
DIALOGUE_GPT_ROUTER_FALLBACK=true

PIPELINE_EXTRACTOR_MODE=pipeline
PIPELINE_HYPOTHESIS_MAX_SIZE=120

M3_MEMORY_BACKEND=inmemory
# M3_SQLITE_PATH=data/memory/profiles.db
